/* Auto-generated by theme-switch.sh — matches quickshell/hyprland style */

* {
    bg:             #1a1b26;
    bg-alt:         #1f2335;
    bg-dark:        #16161e;
    fg:             #a9b1d6;
    fg-bright:      #c0caf5;
    accent:         #0db9d7;
    accent-alt:     #ad8ee6;
    urgent:         #f7768e;
    success:        #9ece6a;
    muted:          #444b6a;
    border-col:     #292e42;

    background-color:   transparent;
    text-color:         @fg;
}

window {
    background-color:   @bg;
    border:             2px solid;
    border-color:       @border-col;
    border-radius:      10px;
    width:              520px;
    padding:            0;
}

mainbox {
    background-color:   transparent;
    spacing:            0;
}

inputbar {
    background-color:   @bg-alt;
    text-color:         @fg-bright;
    padding:            14px 16px;
    border-radius:      10px 10px 0 0;
    spacing:            10px;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @accent;
    background-color:   transparent;
}

entry {
    text-color:         @fg-bright;
    background-color:   transparent;
    placeholder:        "Search...";
    placeholder-color:  @muted;
}

listview {
    background-color:   @bg;
    padding:            6px 0;
    lines:              8;
    fixed-height:       false;
    dynamic:            true;
    scrollbar:          false;
    spacing:            2px;
}

element {
    padding:            10px 16px;
    background-color:   @bg;
    text-color:         @fg;
    border-radius:      0;
}

element selected.normal {
    background-color:   @bg-alt;
    text-color:         @accent;
}

element selected.urgent {
    background-color:   @bg-alt;
    text-color:         @urgent;
}

element selected.active {
    background-color:   @bg-alt;
    text-color:         @success;
}

element normal.urgent {
    text-color:         @urgent;
}

element normal.active {
    text-color:         @success;
}

element-icon {
    size:               20px;
    margin:             0 10px 0 0;
    background-color:   transparent;
}

element-text {
    text-color:         inherit;
    background-color:   transparent;
    vertical-align:     0.5;
}

message {
    background-color:   @bg-alt;
    border:             1px solid;
    border-color:       @border-col;
    border-radius:      0 0 10px 10px;
    padding:            10px 16px;
}

textbox {
    text-color:         @muted;
    background-color:   transparent;
}

scrollbar {
    handle-color:       @muted;
    background-color:   @bg-alt;
    handle-width:       4px;
    border-radius:      2px;
}
